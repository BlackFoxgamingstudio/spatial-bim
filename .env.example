# Sovereign Spatial BIM — Environment Configuration
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to version control

# ── Core Service ──────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8780
LOG_LEVEL=INFO
SBB_API_KEY=change-me-secret-key-min-32-chars

# ── n8n Integration ───────────────────────────────────
SBB_N8N_EVENT_BUS_URL=http://localhost:5678/webhook/event-bus
SBB_N8N_WEBHOOK_SECRET=change-me-webhook-secret

# ── 3D Graphics & Spatial BIM ─────────────────────────────────
SBB_IFC_SCHEMA_VERSION=
SBB_CLASH_TOLERANCE_MM=
SBB_MESH_LOD=
SBB_AR_TARGET_PLATFORM=

# ── Observability ────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=
